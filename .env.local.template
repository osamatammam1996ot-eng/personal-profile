# STOP - READ CAREFULLY BEFORE EDITING

# This file contains sensitive credentials for Supabase access
# Keep it PRIVATE - Never commit to git or share publicly
# It's already in .gitignore

# ============================================================================
# TO GET YOUR CREDENTIALS:
# ============================================================================
# 
# 1. Go to Supabase Dashboard: https://app.supabase.com
# 2. Select project "FigMakeTestDrive" (lajgxkcqnqmgzofshqdg)
# 3. Click Settings (gear icon) → API
# 4. You'll see:
#    - Service Role Key (with secret icon)
#    - Anon Public Key (safe for frontend)
#    - Project URL
#    - JWT Secret
#
# 5. Copy the values below and replace XXX placeholders
#
# ============================================================================

# Project URL (from Settings → API)
# Copy from: "Project URL" section
VITE_SUPABASE_URL=https://lajgxkcqnqmgzofshqdg.supabase.co

# Anon Public Key (Safe for frontend use)
# Copy from: "anon" public key (the longer one)
# This key is public - it's safe to expose in frontend code
VITE_SUPABASE_ANON_KEY=XXX_REPLACE_WITH_ANON_KEY_XXX

# Service Role Key (Keep secret - server-side only)
# Copy from: "service_role" secret key
# WARNING: Never expose this in frontend or commit to git
VITE_SUPABASE_SERVICE_ROLE_KEY=XXX_REPLACE_WITH_SERVICE_KEY_XXX

# JWT Secret (for auth)
# Copy from: "JWT Secret" field at bottom
VITE_SUPABASE_JWT_SECRET=XXX_REPLACE_WITH_JWT_SECRET_XXX

# ============================================================================
# OPTIONAL: Image storage configuration
# ============================================================================

# Supabase storage bucket name for images
VITE_STORAGE_BUCKET=portfolio-images

# Supabase storage URL base
VITE_STORAGE_BASE_URL=https://lajgxkcqnqmgzofshqdg.supabase.co/storage/v1/object/public

# ============================================================================
# OPTIONAL: Analytics and debugging
# ============================================================================

# Set to 'true' to see verbose console logs
VITE_DEBUG_CMS=false

# ============================================================================
# SUMMARY OF WHAT EACH VARIABLE DOES:
# ============================================================================
#
# VITE_SUPABASE_URL
#   - The API endpoint for your Supabase project
#   - Public information (in browser Network requests)
#   - Safe to expose in frontend
#
# VITE_SUPABASE_ANON_KEY
#   - Anonymous JWT key for public operations
#   - Used by frontend to connect to database
#   - RLS policies determine what user can access
#   - Safe to expose in frontend
#
# VITE_SUPABASE_SERVICE_ROLE_KEY
#   - Admin key for server-side operations only
#   - Can bypass RLS policies
#   - NEVER expose in frontend - keep on server only
#   - Used only for backend admin services
#
# VITE_SUPABASE_JWT_SECRET
#   - Secret key for signing JWTs
#   - Used for authentication
#   - Keep private
#
# ============================================================================
# QUICK CHECK:
# ============================================================================
# 
# After filling in the values, test with:
#   npm run dev
#
# In browser console, you should see:
#   - No errors about missing VITE_ variables
#   - Website content loads from Supabase
#   - Language toggle works (EN/AR)
#
