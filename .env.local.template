# Next.js Environment Variables Template
# In Next.js:
# - Client-side variables (exposed to browser) MUST start with NEXT_PUBLIC_
# - Server-side variables (Server Actions / Server Components) do NOT need NEXT_PUBLIC_

# Client-Side Public Credentials
NEXT_PUBLIC_SUPABASE_URL=https://lajgxkcqnqmgzofshqdg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=XXX_REPLACE_WITH_ANON_KEY_XXX

# Server-Side Auth & Security (Server Actions Only)
# Admin dashboard password. Required on Vercel — login is disabled without it.
# Locally it is optional (falls back to "development-secret" under `next dev`).
# Forgot it? Change this value in Vercel and redeploy.
ADMIN_SECRET=XXX_REPLACE_WITH_A_LONG_UNIQUE_PASSWORD_XXX

# Supabase Service Role Key (server-side only — bypasses RLS for CMS writes)
# Get this from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=XXX_REPLACE_WITH_SERVICE_ROLE_KEY_XXX

# Vercel Storage Environment Variables (Auto-injected on Vercel)
